# Inert template for a separate, dedicated load-test host. This does not create
# or authorize a host. Copy to a private file OUTSIDE the repository, set mode
# 0600, then verify test-only application credentials, stores and destinations.
# Never use the production or retired host, its Docker daemon, or its .env.vps.
#
# Select that file explicitly in the caller:
# MAXIM_VPS_ENV_FILE=/absolute/private/loadtest.env MAXIM_ALLOW_SCALE_DEPLOY=1 \
#   ./infra/scripts/vps-connect.sh deploy-scale <reviewed-branch>
# Every required value below must be replaced with independently verified data.
# Blank identity/connection fields intentionally make this template unusable.

MAXIM_SCALE_DEPLOY_PROFILE=isolated-loadtest-v1
# Exact lowercase 32-hex /etc/machine-id from the dedicated test host.
MAXIM_SCALE_EXPECTED_MACHINE_ID=
# Explicit SSH alias or user@host for that host; its effective HostName is checked.
MAXIM_VPS_SSH_TARGET=
# Canonical absolute physical checkout path on that host, dedicated to load tests.
# MAXIM_SCALE_EXPECTED_REPO_DIR is derived by the connector; do not set it here.
MAXIM_VPS_REPO_DIR=
# Explicit http(s) test origin without a path, query, fragment or credentials.
MAXIM_VPS_PUBLIC_URL=

MAXIM_VPS_AUTO_AUTHORIZE_SSH=0
# Optional local SSH configuration; preserve strict host-key verification.
# MAXIM_VPS_SSH_PORT=22
# MAXIM_VPS_SSH_KEY=$HOME/.ssh/loadtest
# MAXIM_VPS_SSH_CONFIG=$HOME/.ssh/config
# Scale refuses MAXIM_VPS_SSH_EXTRA_ARGS; put complex options in the SSH config.
# Do not configure cloud fallback, DOCKER_HOST or DOCKER_CONTEXT.
