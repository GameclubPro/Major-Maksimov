MAX_BOT_STATE=active
MAX_BOT_OWNERSHIP_WEIGHT=1
MAX_ENTRY_BOT_ID=id613070470872_9_bot
MAX_BOT_TOKEN=change-me
MAX_WEBHOOK_SECRET_PATH=replace-with-random-url-safe-secret
MAX_WEBHOOK_HEADER_SECRET=replace-with-random-url-safe-secret
MAX_BOTS_JSON=[{"id":"id613070470872_5_bot","label":"Майор Максимова","characterName":"Майор Максимова","speechPersona":"female","token":"replace-with-majorova-token","contactId":"274743500","webhookSecretPath":"replace-with-majorova-random-url-safe-secret","webhookHeaderSecret":"replace-with-majorova-random-url-safe-secret","state":"dormant","ownershipWeight":1,"visibleInAdmin":true},{"id":"id613070470872_6_bot","label":"Рэкс","characterName":"Рэкс","speechPersona":"neutral","token":"replace-with-rex-token","contactId":"279607023","webhookSecretPath":"replace-with-rex-random-url-safe-secret","webhookHeaderSecret":"replace-with-rex-random-url-safe-secret","state":"dormant","ownershipWeight":1,"visibleInAdmin":true}]
MAX_PUBLISHER_BOT_ID=se14088825_bot
MAX_PUBLISHER_DISPATCH_ENABLED=false
# off -> test -> 5 -> 25 -> 100; staged acceptance is required before each increase.
PUBLISHER_TEMPORAL_SELECTION_ROLLOUT=off
# Independent unchanged-rollup reader; occurrence-scoped test acceptance before expansion.
PUBLISHER_OCCURRENCE_ROLLUP_NOOP_ROLLOUT=off
# canary: queue-wide deadline priorities and independent roster scheduling for 10% of bindings.
MAX_PUBLISHER_ACCESS_REFRESH_MODE=off
VK_BOT_REVIEW_ENABLED=true
PUBLISHER_POST_IMPORT_ENABLED=false
PUBLISHER_AUTO_REPLY_EXTENDED_MATCHING_MODE=on
MAXIM_PUBLISHER_BOT_TOKEN_SECRET_FILE=/dev/null
MAXIM_PUBLISHER_WEBHOOK_SECRET_FILE=/dev/null
MAXIM_PUBLISHER_INIT_DATA_KEYS_SECRET_FILE=/dev/null
BOT_OWNERSHIP_REBALANCE_MODE=shadow
BOT_OWNERSHIP_REBALANCE_CANARY_PERCENT=1
BOT_OWNERSHIP_REBALANCE_CANARY_ENTITY_IDS=
BOT_OWNERSHIP_REBALANCE_MAX_MOVES_PER_RUN=25
CHAT_ROUTING_RECONCILE_INTERVAL_MS=500
CHAT_ROUTING_RECONCILE_BATCH_SIZE=250
CHAT_ROUTING_RECONCILE_CONCURRENCY=8
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_RESUMABLE_VIDEO_UPLOAD_ENABLED=true
MAX_JOIN_DENY_CHAT_IDS=

# API23
PORT=3001
# Legacy (not used by current MAX init_data validation)
INIT_DATA_HMAC_SECRET=
INIT_DATA_MAX_AGE_SEC=3600
MAX_PUBLISHER_INIT_DATA_KEYS_FILE=
MAX_PUBLISHER_DIALOG_SIGNING_KEY_FILE=
SYSTEM_ADMIN_USER_IDS=
# FLAG: Independent read-only observation; blank disables it. Provision only for api-admin.
RUNTIME_OVERVIEW_READER_TOKEN_SHA256=

# Database
DATABASE_URL=postgresql://maxim:maxim@postgres:5432/maxim?schema=public
REDIS_URL=redis://redis:6379

# Security
WEBHOOK_GLOBAL_RPS_LIMIT=300
WEBHOOK_BURST_LIMIT=450
WEBHOOK_BODY_LIMIT_BYTES=1048576
WEBHOOK_ACK_DEADLINE_MS=18000
WEBHOOK_RATE_LIMIT_REDIS_TIMEOUT_MS=100
WEBHOOK_RECEIPT_MAX_IN_FLIGHT=64
WEBHOOK_MEMBERSHIP_CACHE_MAX_IN_FLIGHT=64
# Local contexts retain the compatible full shape; weight is an estimate, not RSS.
CHAT_CONTEXT_LOCAL_CACHE_TTL_MS=30000
CHAT_CONTEXT_LOCAL_CACHE_MAX_BYTES=134217728
CHAT_CONTEXT_LOCAL_CACHE_MAX_ENTRIES=2048
CHAT_CONTEXT_LOCAL_CACHE_MAX_ENTRY_BYTES=134217728
CHAT_CONTEXT_LOCAL_CACHE_SWEEP_INTERVAL_MS=5000
CHAT_CONTEXT_LOCAL_CACHE_SWEEP_BATCH_SIZE=128
SYSTEM_WEBHOOK_INGRESS_SLO_TARGET_MS=2000
WEBHOOK_CANONICAL_EXECUTION_MODE=shadow
WEBHOOK_CANONICAL_EXECUTION_CANARY_PERCENT=1
WEBHOOK_CANONICAL_EXECUTION_CANARY_ENTITY_IDS=
MAX_EXTENDED_WEBHOOK_LIFECYCLE_MODE=shadow
MAX_EXTENDED_WEBHOOK_LIFECYCLE_CANARY_PERCENT=1
MAX_EXTENDED_WEBHOOK_LIFECYCLE_CANARY_ENTITY_IDS=
ENQUEUE_POLL_INTERVAL_MS=200
ENQUEUE_BATCH_SIZE=400
ENQUEUE_CONCURRENCY=32
ENQUEUE_MAX_ATTEMPTS=120
MAX_WEBHOOK_RECONCILE_INTERVAL_MS=60000
MAX_WEBHOOK_STALE_INGRESS_MS=300000
MAX_WEBHOOK_STALE_RECREATE_COOLDOWN_MS=600000
QUEUE_LAG_DEGRADE_SEC=10
DEGRADE_STABILIZE_SEC=300
RAW_PAYLOAD_SAMPLE_RATE=0.01
WEBHOOK_RETENTION_DAYS=7
# Receipt cleanup also deletes execution claims. Keep both off until the lifecycle gates pass.
WEBHOOK_COMPLETED_RETENTION_ENABLED=false
WEBHOOK_FAILED_RETENTION_ENABLED=false
MODERATION_RETENTION_DAYS=90
MAX_API_GLOBAL_RPS=30
# Shared per-chat/user budget for all MAX calls caused by active-mute deletion attempts.
MAX_MUTED_USER_API_PROTECTION_ENABLED=true
# Zero spreads token admissions evenly; omitted keeps the legacy RPS-1 burst.
MAX_API_GLOBAL_BURST=0
# Six-hour diagnostics use minute hashes; legacy is an explicit writer downgrade.
# API rollback must still retain compatible readers after a downgrade.
MAX_API_METRICS_STORAGE_LAYOUT=minute
MAX_API_CHAT_RPS=10
MAX_API_LIST_BOT_CHATS_CACHE_SEC=15
MAX_API_CHAT_SNAPSHOT_CACHE_SEC=10
MANAGED_ENTITY_HEADER_CACHE_SEC=86400
MAX_API_CIRCUIT_FAILURE_THRESHOLD=30
MAX_API_CIRCUIT_WINDOW_SEC=30
MAX_API_CIRCUIT_OPEN_SEC=20
MAX_API_CIRCUIT_HALF_OPEN_PROBE_SEC=60
MAX_ROUTED_MUTATIONS_MODE=shadow
MAX_ROUTED_MUTATIONS_CANARY_PERCENT=1
MAX_ROUTED_MUTATIONS_CANARY_ENTITY_IDS=
MAX_CROSS_BOT_EDIT_DELETE_ENABLED=false
MAX_ACTION_DISPATCH_ENABLED=true
MAX_ACTION_FAILED_RETENTION_AGE_SEC=604800
MAX_ACTION_FAILED_RETENTION_COUNT=1000
MAX_ACTION_LEDGER_WATCHDOG_MODE=shadow
MAX_ACTION_LEDGER_WATCHDOG_CANARY_PERCENT=1
MAX_ACTION_LEDGER_WATCHDOG_CANARY_ENTITY_IDS=
APP_ROLE=all
# Optional split-runtime service profile. Production compose sets this per API role.
# APP_SERVICE_NAME=api-ingress
MODERATION_CONCURRENCY=24
MODERATION_LINK_TEXT_CLICKABILITY_ENABLED=true
ACTION_CONCURRENCY=24
MAX_ACTION_CRITICAL_CONCURRENCY=3
MAX_ACTION_INTERACTIVE_CONCURRENCY=2
MAX_ACTION_BACKGROUND_CONCURRENCY=1
JSON_BODY_LIMIT=33554432

# Karavan storefront relay
# Chat marketplaces: dedicated credentials, disabled until both releases are ready.
KARAVAN_MARKETPLACE_ENABLED=false
KARAVAN_MARKETPLACE_API_BASE_URL=https://karavan.major-maksimov.ru/karavan
KARAVAN_MARKETPLACE_AUTHORITY_TOKEN=replace-with-independent-32-character-secret
KARAVAN_MARKETPLACE_COMMAND_TOKEN=replace-with-another-independent-32-character-secret
KARAVAN_SELLER_BOT_USERNAME=se13381675_bot
KARAVAN_STOREFRONT_RELAY_ENABLED=false
KARAVAN_API_BASE_URL=https://karavan.major-maksimov.ru/karavan/api
KARAVAN_INTEGRATION_TOKEN=replace-with-at-least-16-chars
KARAVAN_STOREFRONT_CATALOG_URL=https://max.ru/se13381675_1_bot?startapp=
KARAVAN_STOREFRONT_CREATE_URL=https://max.ru/se13381675_bot?startapp=storefront
KARAVAN_STOREFRONT_LOOKUP_TIMEOUT_MS=3000
KARAVAN_STOREFRONT_CACHE_TTL_SEC=120
KARAVAN_STOREFRONT_RELAY_LOCK_TTL_SEC=3600

# Durable moderation deletes start as observation-only. Canary chat IDs are comma-separated.
MODERATION_DELETE_INTENT_MODE=shadow
# Message retention remains off until its separate capacity and canary gates pass.
MESSAGE_RETENTION_MODE=off
MESSAGE_RETENTION_CANARY_CHAT_IDS=
# Participant reports remain opt-in per chat, with a separate rollout ceiling.
PARTICIPANT_REPORTS_MODE=off
PARTICIPANT_REPORTS_CANARY_CHAT_IDS=
# Detailed votes/actions expire after 30 days; activate after compatible fleet rollout.
PARTICIPANT_REPORTS_DETAIL_RETENTION_ENABLED=false
PARTICIPANT_REPORTS_DETAIL_RETENTION_DAYS=30
MODERATION_DELETE_INTENT_CANARY_CHAT_IDS=
MODERATION_DELETE_CROSS_BOT_CANARY_CHAT_IDS=
MODERATION_DELETE_INTENT_RECOVERY_BATCH_SIZE=10
MODERATION_DELETE_INTENT_PURGE_MAX_BATCHES=40

# Structured profanity sensitivity is active; set legacy only as a temporary rollback switch.
PROFANITY_V2_ROLLOUT_MODE=on

# Photo anti-duplicate enforcement remains opt-in and exact-match/delete-only by default.
PHOTO_DUPLICATE_ROLLOUT_MODE=shadow
PHOTO_DUPLICATE_ENFORCEMENT_CHAT_IDS=
PHOTO_DUPLICATE_ADVANCED_CANARY_CHAT_IDS=
PHOTO_DUPLICATE_ALLOWED_MATCH_KINDS=canonical_sha256
PHOTO_DUPLICATE_MAX_ACTION=DELETE_MESSAGE
PHOTO_DUPLICATE_ALLOWED_HOSTS=i.oneme.ru,fd.oneme.ru

# Commercial-image OCR rollout is shared by enqueue, media analysis, and action guard roles.
COMMERCIAL_OCR_ROLLOUT_MODE=shadow
COMMERCIAL_OCR_CANARY_CHAT_IDS=
COMMERCIAL_OCR_VERSION=tesseract-rus-eng-v2
COMMERCIAL_OCR_RESERVED_ACTIONABLE_IMAGE_UNITS=4
COMMERCIAL_OCR_CERTIFICATION_APPROVAL_PUBLIC_KEY_BASE64=
# Explicit per-chat image stop lists may enforce only through the verified native sandbox.
IMAGE_TEXT_STOP_LIST_OCR_ROLLOUT_MODE=on

# VK parsing
# Required for VK source import/autoposting. Keep the real token only in ignored env/VPS secrets.
VK_SERVICE_TOKEN=replace-with-vk-service-token

# Provision with sibling MAX-MARKET infra/scripts/provision-maxim-integration.mjs.
# Optional shared marketplace analytics/profile integration. Both keys must be configured.
# Keep absent until the separately reviewed pilot is enabled. Do not reuse existing integration keys.
# Configuration: sibling MAX-MARKET/docs/maxim-integration-provisioning.md.
# SVYAZKA_ANALYTICS_TOKEN=
# SVYAZKA_PROFILE_TOKEN=
# SVYAZKA_STATISTICS_EXPORT_TOKEN=
SVYAZKA_STATISTICS_V2_USERS=323459159
