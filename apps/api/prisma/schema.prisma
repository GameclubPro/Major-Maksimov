  checkedAt             DateTime  @map("checked_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  exchangeId            String?   @map("exchange_id") @db.Uuid
  exchangedAt           DateTime? @map("exchanged_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorMaxUserId, commandId], map: "karavan_marketplace_handoff_actor_command_key")
  @@index([expiresAt], map: "karavan_marketplace_handoff_expiry_idx")
  @@map("karavan_marketplace_handoffs")
}

model KaravanMarketplaceConnectionOperation {
  anchorChatId          String    @map("anchor_chat_id")
  activeScopeKey        String?   @unique(map: "karavan_marketplace_operation_active_scope_key") @map("active_scope_key")
  id                    String    @id @db.Uuid
