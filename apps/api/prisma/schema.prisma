  blocker WebhookEvent @relation("QuarantineBlocker", fields: [blockerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  anchor WebhookEvent @relation("QuarantineAnchor", fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([receiptId, blockerId])
  @@index([state, nextCheckAt, receiptId, blockerId], map: "webhook_dependency_quarantines_due_idx")
  @@index([anchorId], map: "webhook_dependency_quarantines_anchor_idx")
  @@index([blockerId], map: "webhook_dependency_quarantines_blocker_idx")
  @@index([state, createdAt, receiptId], map: "webhook_dependency_quarantines_age_idx")
  @@map("webhook_dependency_quarantines")
}

