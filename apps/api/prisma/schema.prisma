  @@index([entityId,day,metric,horizon],map:"stats_measurements_entity_day_idx")
  @@index([day,entityId],map:"stats_measurements_retention_idx")
  @@map("stats_measurements")
}
model StatsIngestRequest {
  producer String
  producerEpoch String @map("producer_epoch") @db.Uuid
  recordKind String @map("record_kind")
  operationKey String @map("operation_key")
  bodyHash String @map("body_hash")
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([producer,producerEpoch,recordKind,operationKey])
  @@index([createdAt,producer,producerEpoch,recordKind,operationKey],map:"stats_ingest_requests_retention_idx")
  @@map("stats_ingest_requests")
}
model StatsChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  entityRevision BigInt @map("entity_revision")
  cause String
  authorityId String? @map("authority_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedSeq BigInt? @unique @map("published_seq")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  entity StatsEntity @relation(fields:[entityId],references:[id],onDelete:Cascade)
  @@index([createdAt,id],map:"stats_changes_retention_idx")
  @@map("stats_changes")
}

// Short-lived, command-bound attestations; independent from Svyazka and publication allowlists.
model KaravanMarketplaceAuthorityGrant {
  id                    String   @id @default(uuid()) @db.Uuid
  actorMaxUserId        String   @map("actor_max_user_id")
  commandId             String   @map("command_id")
  chatId                String   @map("chat_id")
  botId                 String   @map("bot_id")
  proofHash             String   @unique @map("proof_hash")
  scopeHash             String   @map("scope_hash")
  scope                 Json
  authorityEpoch        String   @map("authority_epoch")
  chatTitle             String?  @map("chat_title")
  principal             Json
  checkedAt             DateTime @map("checked_at") @db.Timestamptz(3)
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([actorMaxUserId, commandId], map: "karavan_marketplace_authority_actor_command_key")
  @@index([expiresAt], map: "karavan_marketplace_authority_expiry_idx")
  @@map("karavan_marketplace_authority_grants")
}

model KaravanMarketplaceHandoff {
  id                    String    @id @default(uuid()) @db.Uuid
  actorMaxUserId        String    @map("actor_max_user_id")
  commandId             String    @map("command_id")
  chatId                String    @map("chat_id")
