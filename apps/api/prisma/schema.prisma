model AdvertisingPlacement {
  chatId       String   @id @map("chat_id")
  enabled      Boolean  @default(false)
  listingId    String?  @map("listing_id") @db.Uuid
  revision     Int      @default(0)
  lastSendId   String?  @map("last_send_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  sends        AdvertisingPlacementSend[]

  @@map("advertising_placements")
}

model AdvertisingPlacementSend {
  id               String   @id @db.Uuid
  chatId           String   @map("chat_id")
  listingId        String   @map("listing_id") @db.Uuid
  settingsRevision Int      @map("settings_revision")
  status           String   @default("SENDING")
  remoteMessageId  String?  @map("remote_message_id")
  createdAt        DateTime @default(now()) @map("created_at")
  placement        AdvertisingPlacement @relation(fields: [chatId], references: [chatId], onDelete: Restrict)

  @@index([chatId, createdAt])
  @@map("advertising_placement_sends")
}

model Chat {
  id             String           @id
  botId          String?          @map("bot_id")
  primaryBotId   String?          @map("primary_bot_id")
  fixedModeratorBotId String?      @map("fixed_moderator_bot_id")
  title          String
  entityType     ChatEntityType   @default(CHAT) @map("entity_type")
  catalogKind    ChatCatalogKind  @default(UNKNOWN) @map("catalog_kind")
  routingState   ChatRoutingState @default(NO_ELIGIBLE_BOT) @map("routing_state")
  routingVersion Int              @default(0) @map("routing_version")
  commerceRoutingEpoch Int        @default(0) @map("commerce_routing_epoch")
  navigationAllowlistRevision Int @default(0) @map("navigation_allowlist_revision")
  chatControlOrderAt DateTime?     @map("chat_control_order_at")
  chatControlOrderKey String?      @map("chat_control_order_key")
  rulesOrderAt DateTime?           @map("rules_order_at")
  rulesOrderKey String?            @map("rules_order_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  settings                          ChatSettings?
  reportCases                       ChatReportCase[]
  rules                             ChatRules?
  channelSettings                   ChannelSettings?
  admins                            ChatAdminAllowlist[]
  domains                           DomainAllowlist[]
  violations                        Violation[]
  events                            ModerationEvent[]
  violationMessageClaims            ModerationViolationMessageClaim[]
  moderationDeleteIntents           ModerationDeleteIntent[]
  requiredSubscriptionCandidates    RequiredSubscriptionCandidate[]
  linkHistoryScanState              ModerationLinkHistoryScanState?
  auditLogs                         AuditLog[]
  moderatorAssignments              ManagedModeratorAssignment[]
  channelAutoPostAttachMarkers      ChannelAutoPostAttachMarker[]
  channelPostDemand                 ChannelPostDemandChannel?
  chatAutoCommentAttachMarkers      ChatAutoCommentAttachMarker[]
  channelAudienceSnapshots          ChannelAudienceSnapshot[]
  audienceObservations              ManagedEntityAudienceObservation[]
  viewArchiveState                  ChannelViewArchiveState?
  channelPosts                      ChannelPost[]
  channelStatsSyncState             ChannelStatsSyncState?
  managedBroadcasts                 ManagedBroadcast[]
  managedAutopostRules              ManagedAutopostRule[]
  publicationTargets                PublicationTarget[]
  managedGiveaways                  ManagedGiveaway[]
  managedPolls                      ManagedPoll[]
  vkParsingSettings                 VkParsingSettings[]
  vkParsingSources                  VkParsingSource[]
  vkParsingPosts                    VkParsingPost[]
  botMemberships                    ChatBotMembership[]
  publisherBinding                  PublisherEntityBinding?
  publisherSettings                 PublisherEntitySettings?
  publisherAutoReplyRules           PublisherAutoReplyRule[]
  publisherAutoReplyAssets          PublisherAutoReplyAsset[]
  publisherAutoReplyDeliveries      PublisherAutoReplyDelivery[]
  publisherAutoReplySessions        PublisherAutoReplyAuthoringSession[]
  publicationPolicy                 ManagedEntityPublicationPolicy?
  accessEdges                       ManagedEntityAccessEdge[]
  adminMembers                      ManagedEntityAdminMember[]
  favorites                         ManagedEntityFavorite[]
  dialogNotificationSubscriptions   DialogNotificationSubscription[]
  dialogNotificationPreferences     DialogNotificationPreference[]
  participantImmunities             ChatParticipantModerationImmunity[]
  karavanStorefrontAllowlistEntries KaravanStorefrontAllowlistEntry[]
  invitationAccessProgress          ChatInvitationAccessProgress[]
  spammerObservations               SpammerObservation[]
  commercialReviewSamples           CommercialReviewSample[]
  globalSpammerCandidateChats       GlobalSpammerCandidateChat[]

  @@index([botId], map: "chats_bot_id_idx")
  @@index([primaryBotId], map: "chats_primary_bot_id_idx")
  @@index([routingState, entityType], map: "chats_routing_state_entity_type_idx")
  @@index([catalogKind, entityType], map: "chats_catalog_kind_entity_type_idx")
  @@index([entityType, updatedAt(sort: Desc), id], map: "chats_entity_type_updated_id_idx")
  @@map("chats")
}

model ManagedModeratorAssignment {
  id                     String   @id
  chatId                 String   @map("chat_id")
  actorUserId            String   @map("actor_user_id")
  botId                  String   @map("bot_id")
  previousBotId          String?  @map("previous_bot_id")
  expectedRoutingVersion Int      @map("expected_routing_version")
  routingVersion         Int      @map("routing_version")
  createdAt              DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt], map: "managed_moderator_assignments_chat_created_idx")
  @@map("managed_moderator_assignments")
}

model ChatBotMembership {
  commerceRevocationEpoch   Int                     @default(0) @map("commerce_revocation_epoch")
  id                        String                  @id @default(cuid())
  chatId                    String                  @map("chat_id")
  botId                     String                  @map("bot_id")
  role                      ChatBotMembershipRole   @default(STANDBY)
  status                    ChatBotMembershipStatus @default(ACTIVE)
  capabilities              Json                    @default("[]")
  permissionsSnapshot       Json?                   @map("permissions_snapshot")
  botAccessState            ChatBotAccessState      @default(UNKNOWN) @map("bot_access_state")
  botAccessCheckedAt        DateTime?               @map("bot_access_checked_at")
  botAccessExpiresAt        DateTime?               @map("bot_access_expires_at")
  botAccessSource           String?                 @map("bot_access_source")
  botAccessLastErrorCode    String?                 @map("bot_access_last_error_code")
  permissionsHash           String?                 @map("permissions_hash")
  sendRouteFailureCount     Int                     @default(0) @map("send_route_failure_count")
  sendRouteQuarantinedUntil DateTime?               @map("send_route_quarantined_until")
  sendRouteLastFailureAt    DateTime?               @map("send_route_last_failure_at")
  sendRouteLastFailureCode  String?                 @map("send_route_last_failure_code")
  sendRouteLastSuccessAt    DateTime?               @map("send_route_last_success_at")
  lastSeenAt                DateTime?               @map("last_seen_at")
  lastWebhookAt             DateTime?               @map("last_webhook_at")
  lifecycleEventAt          DateTime?               @map("lifecycle_event_at")
  lifecycleEventType        String?                 @map("lifecycle_event_type")
  lifecycleSource           String?                 @map("lifecycle_source")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, botId], map: "chat_bot_memberships_chat_id_bot_id_key")
  @@index([botId, role, status], map: "chat_bot_memberships_bot_id_role_status_idx")
  @@index([chatId, status], map: "chat_bot_memberships_chat_id_status_idx")
  @@index([chatId, botAccessState, botAccessCheckedAt(sort: Desc)], map: "chat_bot_memberships_chat_access_state_checked_idx")
  @@index([botId, botAccessState, botAccessCheckedAt(sort: Desc)], map: "chat_bot_memberships_bot_access_state_checked_idx")
  @@index([chatId, status, lifecycleEventAt(sort: Desc)], map: "chat_bot_memberships_chat_status_lifecycle_idx")
  @@map("chat_bot_memberships")
}

model PublisherEntityBinding {
  chatId                    String                  @id @map("chat_id")
  publisherBotId            String                  @map("publisher_bot_id")
  status                    ChatBotMembershipStatus @default(ACTIVE)
  capabilities              Json                    @default("[]")
  permissionsSnapshot       Json?                   @map("permissions_snapshot")
  botAccessState            ChatBotAccessState      @default(UNKNOWN) @map("bot_access_state")
  botAccessCheckedAt        DateTime?               @map("bot_access_checked_at")
  botAccessExpiresAt        DateTime?               @map("bot_access_expires_at")
  botAccessSource           String?                 @map("bot_access_source")
  botAccessLastErrorCode    String?                 @map("bot_access_last_error_code")
  permissionsHash           String?                 @map("permissions_hash")
  sendRouteFailureCount     Int                     @default(0) @map("send_route_failure_count")
  sendRouteQuarantinedUntil DateTime?               @map("send_route_quarantined_until")
  sendRouteLastFailureAt    DateTime?               @map("send_route_last_failure_at")
  sendRouteLastFailureCode  String?                 @map("send_route_last_failure_code")
  sendRouteLastSuccessAt    DateTime?               @map("send_route_last_success_at")
  lastSeenAt                DateTime?               @map("last_seen_at")
  lastWebhookAt             DateTime?               @map("last_webhook_at")
  lifecycleEventAt          DateTime?               @map("lifecycle_event_at")
  lifecycleEventType        String?                 @map("lifecycle_event_type")
  lifecycleSource           String?                 @map("lifecycle_source")
  rosterCheckedAt           DateTime?               @map("roster_checked_at")
  rosterRefreshAfter        DateTime?               @map("roster_refresh_after")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([publisherBotId, status], map: "publisher_entity_bindings_bot_status_idx")
  @@index([botAccessState, botAccessCheckedAt(sort: Desc)], map: "publisher_entity_bindings_access_checked_idx")
  @@index([status, sendRouteQuarantinedUntil], map: "publisher_entity_bindings_status_quarantine_idx")
  @@index([publisherBotId, status, botAccessExpiresAt, chatId], map: "publisher_bindings_expiry_idx")
  @@index([publisherBotId, status, rosterRefreshAfter, chatId], map: "publisher_bindings_roster_due_idx")
  @@map("publisher_entity_bindings")
}

// FLAG: Diagnostic obligations never grant access and deliberately outlive binding deletion.
model PublisherAccessRefreshObligation {
  publisherBotId String   @map("publisher_bot_id")
  chatId         String   @map("chat_id")
  proofCheckedAt DateTime @map("proof_checked_at")
  requiredBefore DateTime @map("required_before")
  observedAt     DateTime @default(now()) @map("observed_at")
  cohort         String
  resolution     String   @default("pending")
  committedAt    DateTime? @map("committed_at")

  @@id([publisherBotId, chatId, proofCheckedAt, requiredBefore], map: "publisher_refresh_obligations_pkey")
  @@index([publisherBotId, requiredBefore], map: "publisher_refresh_obligations_deadline_idx")
  @@index([requiredBefore], map: "publisher_refresh_obligations_retention_idx")
  @@map("publisher_access_refresh_obligations")
}

model PublisherEntitySettings {
  chatId                    String   @id @map("chat_id")
  chatCommentsEnabled       Boolean  @default(false) @map("chat_comments_enabled")
  chatCommentsAdminsEnabled Boolean  @default(false) @map("chat_comments_admins_enabled")
  chatCommentsPostsEnabled  Boolean  @default(false) @map("chat_comments_posts_enabled")
  chatCommentsReplaceOriginalEnabled Boolean @default(false) @map("chat_comments_replace_original_enabled")
  channelCommentsEnabled    Boolean  @default(false) @map("channel_comments_enabled")
  channelSuggestionsEnabled Boolean  @default(false) @map("channel_suggestions_enabled")
  channelSuggestionsRequireSubscription Boolean @default(false) @map("channel_suggestions_require_subscription")
  channelSuggestionsDeleteOnUnsubscribe Boolean @default(false) @map("channel_suggestions_delete_on_unsubscribe")
  autoRepliesEnabled        Boolean  @default(false) @map("auto_replies_enabled")
  autoReplyConfigRevision   Int      @default(0) @map("auto_reply_config_revision")
  revision                  Int      @default(0)
  updatedByUserId           String?  @map("updated_by_user_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("publisher_entity_settings")
}

model SuggestionSubscriptionWatch {
  id           String    @id
  chatId       String    @map("chat_id")
  authorUserId String    @map("author_user_id")
  profile      String
  botId        String    @map("bot_id")
  nextCheckAt  DateTime   @default(now()) @map("next_check_at")
  missingSince DateTime?  @map("missing_since")
  checkedAt    DateTime?  @map("checked_at")
  leaseToken   String?   @map("lease_token")
  leaseUntil   DateTime?  @map("lease_until")
  publicationCursor String? @map("publication_cursor")
  revision     Int       @default(0)
  publications SuggestionSubscriptionPublication[]

  @@unique([chatId, authorUserId, profile, botId], map: "suggestion_subscription_watch_owner_key")
  @@index([profile, nextCheckAt, id], map: "suggestion_subscription_watch_due_idx")
  @@map("suggestion_subscription_watches")
}

model SuggestionSubscriptionPublication {
  id             String    @id
  watchId        String    @map("watch_id")
  publicationId  String?   @map("publication_id")
  messageId      String?   @map("message_id")
  deliveryId     String?   @map("delivery_id")
  publishedAt    DateTime  @default(now()) @map("published_at")
  deletedAt      DateTime? @map("deleted_at")
  deleteIntentId String?   @map("delete_intent_id")
  watch SuggestionSubscriptionWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId, deletedAt, id], map: "suggestion_subscription_publications_watch_idx")
  @@index([publicationId], map: "suggestion_subscription_publications_publication_idx")
  @@map("suggestion_subscription_publications")
}

model PublisherAutoReplyRule {
  id                       String    @id @default(cuid())
  chatId                   String    @map("chat_id")
  phrase                   String
  normalizedPhrase         String    @map("normalized_phrase")
  matchInContext           Boolean   @default(false) @map("match_in_context")
  fuzzyMatch               Boolean   @default(false) @map("fuzzy_match")
  enabled                  Boolean   @default(true)
  cooldownSeconds          Int       @default(30) @map("cooldown_seconds")
  version                  Int       @default(1)
  currentContentRevisionId String?   @unique(map: "publisher_auto_reply_rules_current_content_revision_id_key") @map("current_content_revision_id")
  authoringSessionId       String?   @map("authoring_session_id")
  createdByUserId          String    @map("created_by_user_id")
  updatedByUserId          String    @map("updated_by_user_id")
  archivedAt               DateTime? @map("archived_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  chat                   Chat                                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  currentContentRevision PublisherAutoReplyContentRevision?   @relation("PublisherAutoReplyCurrentContentRevision", fields: [currentContentRevisionId], references: [id], onDelete: SetNull)
  contentRevisions       PublisherAutoReplyContentRevision[]  @relation("PublisherAutoReplyContentRevisions")
  deliveries             PublisherAutoReplyDelivery[]
  cooldowns              PublisherAutoReplyCooldown[]
  mutationRecords        PublisherAutoReplyMutationRecord[]
  authoringSessions      PublisherAutoReplyAuthoringSession[]
  triggers               PublisherAutoReplyTrigger[]

  @@unique([id, chatId], map: "publisher_auto_reply_rules_id_chat_id_key")
  @@index([chatId, archivedAt, updatedAt(sort: Desc), id], map: "publisher_auto_reply_rules_chat_archived_updated_idx")
  @@index([chatId, normalizedPhrase], map: "publisher_auto_reply_rules_chat_normalized_phrase_idx")
  @@index([chatId, enabled, archivedAt], map: "publisher_auto_reply_rules_chat_enabled_archived_idx")
  @@index([authoringSessionId, archivedAt], map: "publisher_auto_reply_rules_authoring_session_archived_idx")
  @@map("publisher_auto_reply_rules")
}

model PublisherAutoReplyTrigger {
  id               String    @id @default(cuid())
  chatId           String    @map("chat_id")
  ruleId           String    @map("rule_id")
  position         Int
  phrase           String
  normalizedPhrase String    @map("normalized_phrase")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  rule       PublisherAutoReplyRule       @relation(fields: [ruleId, chatId], references: [id, chatId], onDelete: Cascade, onUpdate: Cascade, map: "publisher_auto_reply_triggers_rule_chat_fkey")
  deliveries PublisherAutoReplyDelivery[]

  @@unique([ruleId, position], map: "publisher_auto_reply_triggers_rule_position_key")
  @@unique([ruleId, normalizedPhrase], map: "publisher_auto_reply_triggers_rule_normalized_phrase_key")
  @@index([chatId, ruleId, position], map: "publisher_auto_reply_triggers_chat_rule_position_idx")
  @@map("publisher_auto_reply_triggers")
}

model PublisherAutoReplyContentRevision {
  id              String                   @id @default(cuid())
  ruleId          String                   @map("rule_id")
  revision        Int
  text            String                   @default("")
  textFormat      PublicationContentFormat @default(PLAIN) @map("text_format")
  buttons         Json                     @default("[]")
  createdByUserId String                   @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  rule              PublisherAutoReplyRule               @relation("PublisherAutoReplyContentRevisions", fields: [ruleId], references: [id], onDelete: Cascade)
  currentForRule    PublisherAutoReplyRule?              @relation("PublisherAutoReplyCurrentContentRevision")
  assets            PublisherAutoReplyContentAsset[]
