{
  "name": "@maxim/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace @maxim/contracts && tsc -p tsconfig.json --noEmit && vite build && node scripts/check-budgets.mjs",
    "budget": "node scripts/check-budgets.mjs",
    "check:css": "node scripts/check-css-architecture.mjs",
    "visual:smoke": "MINIAPP_SCREENSHOT_PRESET=smoke node ../../scripts/capture-miniapp-preview.mjs",
    "preview": "vite preview",
    "typecheck": "npm run build --workspace @maxim/contracts && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test ./test/*.test.ts"
  },
  "dependencies": {
    "@maxim/contracts": "0.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "iconoir-react": "^7.11.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "postcss": "^8.5.26",
    "vite": "^8.1.3"
  }
}
